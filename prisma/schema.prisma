// ═══════════════════════════════════════════════════════════════════════════════

model StateLeadApplication {
  id                 String          @id @default(cuid())
  userId             String?
  name               String
  email              String
  phone              String?
  state              String
  city               String?
  citiesCovered      String?
  currentRole        String?
