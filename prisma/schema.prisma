// prisma/schema.prisma
// KailshiansX — Full data model v1.0
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EVENT_MANAGER
  VIEWER
  CAMPUS_LEAD
  STATE_LEAD
  CHAPTER_LEAD
  PARTNER
  JUDGE
  MEMBER
}

enum ChapterType {
  CAMPUS
  REGIONAL_CITY
}

enum ChapterStatus {
  ACTIVE
  PENDING_REVIEW
  PAUSED
  ARCHIVED
}

enum ChapterMemberRole {
  LEAD
  CO_LEAD
  CORE_TEAM
  MEMBER
}

enum ChapterMemberStatus {
  ACTIVE
  INACTIVE
}

enum ChapterHealthStatus {
  EXCELLENT
  HEALTHY
  NEEDS_ATTENTION
  CRITICAL
}

enum ChapterEventStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum SpeakerAvailabilityStatus {
  AVAILABLE
  LIMITED
  BUSY
  UNAVAILABLE
}

enum BookingRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum EventType {
  MEETUP
  HACKATHON
  WORKSHOP
  TECH_TALK
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SeriesKind {
  MEETUP
  HACKATHON
}

enum SpeakerRole {
  SPEAKER
  JUDGE
  MENTOR
}

enum PartnerTier {
  TITLE
  PLATINUM
  GOLD
  SILVER
  BRONZE
  COMMUNITY
  MEDIA
}

enum SponsorDealStage {
  PROSPECT
  INITIAL_CONTACT
  PITCHING
  PROPOSAL_SENT
  NEGOTIATION
  CONTRACT_SIGNED
  WON
  LOST
}

enum DeliverableStatus {
  PENDING
  IN_PROGRESS
  FULFILLED
  WAIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  WAITLISTED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  NONE
  REQUESTED
  PROCESSED
  REJECTED
}

enum AttendanceMode {
  IN_PERSON
  VIRTUAL
  HYBRID
}

// — Campus Lead workflow
enum CampusLeadStatus {
  APPLIED
  SCREENING
  INTERVIEW
  SELECTED
  ACTIVE
  ALUMNI
  INACTIVE
}

// — State Lead workflow
enum StateLeadStatus {
  APPLIED
  SCREENING
  INTERVIEW
  SELECTED
  ACTIVE
  ALUMNI
  INACTIVE
}

// — Join Team workflow
enum TeamApplicationStatus {
  NEW
  REVIEWING
  INTERVIEW
  SELECTED
  REJECTED
}

// — Collaboration pipeline
enum CollaborationType {
  COLLEGE
  COMMUNITY
  VENUE
  SPONSOR
}

enum CollaborationStage {
  LEAD
  NEW
  CONTACTED
  MEETING
  NEGOTIATING
  NEGOTIATION
  CONFIRMED
  WON
  DECLINED
  LOST
  COMPLETED
}

enum RevenueCategory {
  TICKET
  SPONSORSHIP
  MERCH
  OTHER
}

enum ExpenseCategory {
  VENUE
  TRAVEL
  FOOD
  SWAG
  MARKETING
  PRINTING
  OPERATIONS
  LOGISTICS
  OTHER
}

enum ContentBlockType {
  HERO
  TEXT
  IMAGE
  VIDEO
  FAQ
  CTA
  TESTIMONIAL
  STATS
  TEAM_GRID
  EVENT_LIST
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PUBLISH
  ARCHIVE
  APPROVE
  REJECT
}

// ═══════════════════════════════════════════════════════════════════════════════
// AUTH.JS TABLES
// ═══════════════════════════════════════════════════════════════════════════════

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ═══════════════════════════════════════════════════════════════════════════════
// USER
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          UserRole  @default(VIEWER)
  deletedAt     DateTime? // soft delete
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Developer Passport & Profile
  username         String?   @unique
  headline         String?
  bio              String?   @db.Text
  github           String?
  linkedin         String?
  twitter          String?
  website          String?
  skills           String[]  @default([])
  isPassportPublic Boolean   @default(true)

  accounts               Account[]
  sessions               Session[]
  registrations          Registration[]
  payments               Payment[]
  certificates           Certificate[]
  teamApplications       TeamApplication[]
  campusLeadApplications CampusLeadApplication[]
  stateLeadApplications  StateLeadApplication[]
  campusLead             CampusLead?
  stateLead              StateLead?
  auditLogs              AuditLog[]

  hackathonTeamsLed        HackathonTeam[]
  hackathonTeamMemberships HackathonTeamMember[]
  hackathonJudgeProfiles   HackathonJudge[]

  // Chapters & Mentorship
  chaptersLed              Chapter[]               @relation("ChapterLeader")
  chapterMemberships       ChapterMember[]
  speakerProfiles          Speaker[]
  bookingRequestsSent      SpeakerBookingRequest[] @relation("BookingRequester")

  @@index([email])
  @@index([role])
  @@index([username])
  isSeed        Boolean   @default(false)
}

// ═══════════════════════════════════════════════════════════════════════════════
// GEOGRAPHY — City, College
// ═══════════════════════════════════════════════════════════════════════════════

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  state     String
  country   String   @default("India")
  createdAt DateTime @default(now())

  events         Event[]
  campusLeads    CampusLead[]
  stateLeads     StateLead[]
  colleges       College[]
  collaborations CollaborationLead[]
  chapters       Chapter[]

  @@index([state])
  isSeed        Boolean   @default(false)
}

model College {
  id        String   @id @default(cuid())
  name      String
  cityId    String
  state     String
  website   String?
  createdAt DateTime @default(now())

  city        City         @relation(fields: [cityId], references: [id])
  campusLeads CampusLead[]

  @@unique([name, cityId])
  @@index([cityId])
  isSeed        Boolean   @default(false)
}

// ═══════════════════════════════════════════════════════════════════════════════
// SPEAKERS (global pool, reused across events)
// ═══════════════════════════════════════════════════════════════════════════════

model Speaker {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  bio          String?  @db.Text
  photo        String?
  designation  String?
  organisation String?
  linkedin     String?
  twitter      String?
  github       String?
  website      String?

  userId                  String?
  user                    User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  isMentor                Boolean                    @default(true)
  isSpeaker               Boolean                    @default(true)
  topics                  String[]                   @default([])
  sessionTypes            String[]                   @default([])
  availabilityStatus      SpeakerAvailabilityStatus  @default(AVAILABLE)
  weeklyAvailabilityHours Int                        @default(5)
  preferredCadence        String?
  meetingPlatform         String?                    @default("Google Meet")
  calendlyUrl             String?
  totalSessionsConducted  Int                        @default(0)
  rating                  Float                      @default(5.0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  eventSpeakers    EventSpeaker[]
  techTalkResources TechTalkResource[]
  bookingRequests  SpeakerBookingRequest[]

  @@index([name])
  @@index([userId])
  @@index([availabilityStatus])
  isSeed        Boolean   @default(false)
}

// ═══════════════════════════════════════════════════════════════════════════════
// PARTNERS (global pool, reused across events)
// ═══════════════════════════════════════════════════════════════════════════════

model Partner {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logo          String?
  website       String?
  category      String? // brand, college, community, media, venue
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  notes         String?  @db.Text

  // Partner Portal
  portalAccessCode     String?
  portalContactEmail   String?
  portalLastAccessedAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  eventPartners EventPartner[]
  deals         SponsorDeal[]
  eventReports  SponsorEventReport[]

  @@index([portalAccessCode])
  isSeed        Boolean   @default(false)
}

// ═══════════════════════════════════════════════════════════════════════════════
// SERIES (Meetup & Hackathon)
// ═══════════════════════════════════════════════════════════════════════════════

model Series {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  kind        SeriesKind
  tagline     String?
  description String?    @db.Text
  coverImage  String?
  logo        String?
  city        String?
  region      String?
  purpose     String?    @db.Text
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  editions SeriesEdition[]

  @@index([kind])
  @@index([slug])
  isSeed        Boolean   @default(false)
}

// Links a Series to a specific Event edition
model SeriesEdition {
  id          String   @id @default(cuid())
  seriesId    String
  eventId     String   @unique // one event per edition
  editionNo   Int // 1, 2, 3…
  theme       String?
  createdAt   DateTime @default(now())

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([seriesId, editionNo])
  @@index([seriesId])
  isSeed        Boolean   @default(false)
}

// ═══════════════════════════════════════════════════════════════════════════════
// EVENTS
// ═══════════════════════════════════════════════════════════════════════════════

model Event {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  title                String
  type                 EventType
  status               EventStatus   @default(DRAFT)
  overview             String?       @db.Text
  coverImage           String?
  cityId               String?
  venue                String?
  venueAddress         String?
  venueMapUrl          String?
  attendanceMode       AttendanceMode @default(IN_PERSON)
  startDate            DateTime
  endDate              DateTime?
  registrationDeadline DateTime?
  eligibility          String?       @db.Text
  maxCapacity          Int?
  isFeatured           Boolean       @default(false)
  category             String?       // MERN, Backend, System Design, DevOps, Cloud, AI, Blockchain, Open Source, Career
  metaTitle            String?
  metaDescription      String?
  deletedAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  city             City?               @relation(fields: [cityId], references: [id])
  seriesEdition    SeriesEdition?
  scheduleItems    EventScheduleItem[]
  tracks           EventTrack[]
  speakers         EventSpeaker[]
  partners         EventPartner[]
  ticketTypes      TicketType[]
  registrations    Registration[]
  galleryAlbums       GalleryAlbum[]
  faqs                EventFaq[]
  revenueItems        EventRevenueItem[]
  expenseItems        EventExpenseItem[]
  sponsorDeals        SponsorDeal[]
  sponsorDeliverables SponsorDeliverable[]
  sponsorInvoices     SponsorInvoice[]
  certificates        Certificate[]
  campusLeadEvents    CampusLeadEvent[]
  stateLeadEvents     StateLeadEvent[]
  leadActivities      LeadActivity[]
  techTalkResource    TechTalkResource?
  hackathonDetail     HackathonDetail?
  chapterEvents       ChapterEvent[]
  sponsorEventReports SponsorEventReport[]

  @@index([status])
  @@index([type])
  @@index([category])
  @@index([startDate])
  @@index([cityId])
  @@index([slug])
  isSeed        Boolean   @default(false)
}

model HackathonDetail {
  id                 String    @id @default(cuid())
  eventId            String    @unique
  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  minTeamSize        Int       @default(1)
  maxTeamSize        Int       @default(4)
  rules              String?   @db.Text
  submissionUrl      String?
  submissionDeadline DateTime?
  prizes             Json?     // Array of { title, amount, perks: string[], track?: string }
  problemStatements  Json?     // Array of { id, title, description, track, criteria?: string[] }
  results            Json?     // Array of { rank: number, title: string, teamName: string, projectName: string, description?: string, repoUrl?: string, demoUrl?: string, track?: string }
  isResultsPublished Boolean   @default(false)
  resultsPublishedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  teams                 HackathonTeam[]
  problemStatementsList HackathonProblemStatement[]
  submissions           HackathonSubmission[]
  judges                HackathonJudge[]
  rubricCriteria        HackathonRubricCriterion[]
  prizesList            HackathonPrize[]

  @@index([eventId])
  isSeed        Boolean   @default(false)
}

enum HackathonTeamStatus {
  FORMING
  READY
  SUBMITTED
  DISQUALIFIED
}

enum TeamMemberRole {
  LEADER
  DEVELOPER
  DESIGNER
  PRODUCT
  RESEARCHER
  OTHER
}

enum TeamMemberStatus {
  INVITED
  ACCEPTED
  DECLINED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  EVALUATED
  DISQUALIFIED
}

enum PrizeDisbursementStatus {
  PENDING
  IN_REVIEW
  PROCESSING
  DISBURSED
}

model HackathonTeam {
  id                 String              @id @default(cuid())
  hackathonDetailId  String
  name               String
  slug               String
  inviteCode         String              @unique
  leaderId           String
  problemStatementId String?
  track              String?
  status             HackathonTeamStatus @default(FORMING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  hackathonDetail    HackathonDetail            @relation(fields: [hackathonDetailId], references: [id], onDelete: Cascade)
  leader             User                       @relation(fields: [leaderId], references: [id])
  problemStatement   HackathonProblemStatement? @relation(fields: [problemStatementId], references: [id], onDelete: SetNull)
  members            HackathonTeamMember[]
  submission         HackathonSubmission?
  prizesWon          HackathonPrize[]

  @@index([hackathonDetailId])
  @@index([inviteCode])
  @@index([leaderId])
}

model HackathonTeamMember {
  id           String           @id @default(cuid())
  teamId       String
  userId       String
  role         TeamMemberRole   @default(DEVELOPER)
  status       TeamMemberStatus @default(ACCEPTED)
  invitedEmail String?
  joinedAt     DateTime         @default(now())

  team         HackathonTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model HackathonProblemStatement {
  id                String          @id @default(cuid())
  hackathonDetailId String
  title             String
  slug              String
  description       String          @db.Text
  track             String
  criteria          String[]        @default([])
  sponsorName       String?
  sponsorLogo       String?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  hackathonDetail   HackathonDetail       @relation(fields: [hackathonDetailId], references: [id], onDelete: Cascade)
  teams             HackathonTeam[]
  submissions       HackathonSubmission[]

  @@index([hackathonDetailId])
  @@index([track])
}

model HackathonSubmission {
  id                 String              @id @default(cuid())
  hackathonDetailId  String
  teamId             String              @unique
  problemStatementId String?
  title              String
  tagline            String?
  description        String              @db.Text
  track              String
  repoUrl            String
  demoUrl            String?
  deckUrl            String?
  videoUrl           String?
  techStack          String[]            @default([])
  status             SubmissionStatus    @default(SUBMITTED)
  submittedAt        DateTime            @default(now())
  normalizedScore    Float?              @default(0)
  rank               Int?
  isWinner           Boolean             @default(false)
  winnerTier         String?             // e.g. "1ST_PLACE", "2ND_PLACE", "3RD_PLACE", "TRACK_WINNER", "HONORABLE_MENTION"
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  hackathonDetail    HackathonDetail            @relation(fields: [hackathonDetailId], references: [id], onDelete: Cascade)
  team               HackathonTeam              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  problemStatement   HackathonProblemStatement? @relation(fields: [problemStatementId], references: [id], onDelete: SetNull)
  scores             HackathonScore[]

  @@index([hackathonDetailId])
  @@index([teamId])
  @@index([track])
  @@index([rank])
  @@index([isWinner])
}

model HackathonJudge {
  id                String          @id @default(cuid())
  hackathonDetailId String
  userId            String
  title             String?
  company           String?
  bio               String?         @db.Text
  track             String?         @default("ALL")
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())

  hackathonDetail   HackathonDetail @relation(fields: [hackathonDetailId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id])
  scores            HackathonScore[]

  @@unique([hackathonDetailId, userId])
  @@index([hackathonDetailId])
  @@index([userId])
}

model HackathonRubricCriterion {
  id                String          @id @default(cuid())
  hackathonDetailId String
  name              String
  description       String?         @db.Text
  maxScore          Int             @default(20)
  weight            Float           @default(1.0)
  sortOrder         Int             @default(0)

  hackathonDetail   HackathonDetail @relation(fields: [hackathonDetailId], references: [id], onDelete: Cascade)

  @@index([hackathonDetailId])
}

model HackathonScore {
  id             String              @id @default(cuid())
  submissionId   String
  judgeId        String
  totalScore     Float
  criteriaScores Json                // Record<criterionId, score>
  feedback       String?             @db.Text
  privateNotes   String?             @db.Text
  submittedAt    DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  submission     HackathonSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judge          HackathonJudge      @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([submissionId, judgeId])
  @@index([submissionId])
  @@index([judgeId])
}

model HackathonPrize {
  id                 String                  @id @default(cuid())
  hackathonDetailId  String
  title              String
  track              String?
  rank               Int?
  cashAmount         Decimal                 @db.Decimal(10, 2) @default(0)
  currency           String                  @default("INR")
  perks              String[]                @default([])
  winningTeamId      String?
  disbursementStatus PrizeDisbursementStatus @default(PENDING)
  disbursedAt        DateTime?
  transactionRef     String?
  notes              String?                 @db.Text
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  hackathonDetail    HackathonDetail         @relation(fields: [hackathonDetailId], references: [id], onDelete: Cascade)
  winningTeam        HackathonTeam?          @relation(fields: [winningTeamId], references: [id], onDelete: SetNull)

  @@index([hackathonDetailId])
  @@index([winningTeamId])
  @@index([disbursementStatus])
}

model EventFaq {
  id        String @id @default(cuid())
  eventId   String
  question  String
  answer    String @db.Text
  sortOrder Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  isSeed        Boolean   @default(false)
}

model EventScheduleItem {
  id          String   @id @default(cuid())
  eventId     String
  startTime   DateTime
  endTime     DateTime?
  title       String
  description String?
  speakerId   String?
  trackId     String?
  sortOrder   Int      @default(0)

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  isSeed        Boolean   @default(false)
}

model EventTrack {
  id          String @id @default(cuid())
  eventId     String
  name        String
  description String?
  color       String?
  sortOrder   Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  isSeed        Boolean   @default(false)
}

model EventSpeaker {
  id        String      @id @default(cuid())
  eventId   String
  speakerId String
  role      SpeakerRole @default(SPEAKER)
  sortOrder Int         @default(0)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@unique([eventId, speakerId, role])
  @@index([eventId])
  @@index([speakerId])
  isSeed        Boolean   @default(false)
}

model EventPartner {
  id        String      @id @default(cuid())
  eventId   String
  partnerId String
  tier      PartnerTier @default(COMMUNITY)
  sortOrder Int         @default(0)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([eventId, partnerId])
  @@index([eventId])
  isSeed        Boolean   @default(false)
}

// ═══════════════════════════════════════════════════════════════════════════════
// TICKETS & REGISTRATIONS
// ═══════════════════════════════════════════════════════════════════════════════

model TicketType {
  id          String   @id @default(cuid())
  eventId     String
  name        String // "General Admission", "Student", "VIP"
  description String?
  price       Decimal  @default(0) @db.Decimal(10, 2)
  quota       Int // max seats for this tier
  saleStart   DateTime?
  saleEnd     DateTime?
  isFree      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@index([eventId])
  isSeed        Boolean   @default(false)
}

model Registration {
  id                String             @id @default(cuid())
  registrationCode  String             @unique // human-readable e.g. KX-2025-001234
  eventId           String
  ticketTypeId      String
  userId            String?
  name              String
  email             String
  phone             String?
  college           String?
  city              String?
  tshirtSize        String?
  dietaryPref       String?
  customFields      Json?              // extra event-specific questions
  status            RegistrationStatus @default(PENDING)
  holdExpiresAt     DateTime?          // seat held for 10 min during payment
  qrCodeUrl         String?
  qrPayload         String?            @db.Text
  checkedInAt       DateTime?
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  event      Event      @relation(fields: [eventId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])
  payment    Payment?
  attendance Attendance?
  certificate Certificate?

  @@index([eventId])
  @@index([email])
  @@index([userId])
  @@index([status])
  @@index([registrationCode])
  isSeed        Boolean   @default(false)
}

model Payment {
  id                  String        @id @default(cuid())
  registrationId      String        @unique
  userId              String?
  razorpayOrderId     String        @unique
  razorpayPaymentId   String?       @unique
  razorpaySignature   String?
  amount              Decimal       @db.Decimal(10, 2)
  currency            String        @default("INR")
  status              PaymentStatus @default(PENDING)
  refundStatus        RefundStatus  @default(NONE)
  refundId            String?
  refundAmount        Decimal?      @db.Decimal(10, 2)
  refundReason        String?       @db.Text
  metadata            Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])

  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([status])
  @@index([userId])
  isSeed        Boolean   @default(false)
}

model Attendance {
  id             String   @id @default(cuid())
  registrationId String   @unique
  checkedInAt    DateTime @default(now())
  checkedInBy    String?  // userId of staff who scanned
  method         String   @default("QR") // QR | MANUAL

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  isSeed        Boolean   @default(false)
}

