  title       String
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blocks ContentBlock[]

  @@index([slug])
