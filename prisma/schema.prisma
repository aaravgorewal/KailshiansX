// ═══════════════════════════════════════════════════════════════════════════════
// EMAIL JOB QUEUE & AUDIT LOG
// ═══════════════════════════════════════════════════════════════════════════════

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum EmailTemplate {
  REGISTRATION_CONFIRMATION
  PAYMENT_FAILED
  REFUND_PROCESSED
  APPLICATION_RECEIVED
  STATUS_CHANGE
  COLLABORATION_ACK
  EVENT_REMINDER_24H
  CERTIFICATE_ISSUED
  LEAD_ONBOARDING
  LEAD_INACTIVITY_NUDGE
  POST_EVENT_FEEDBACK_NEXT_STEP
}

model EmailLog {
  id           String         @id @default(cuid())
  template     EmailTemplate
  recipient    String
  subject      String
  status       EmailJobStatus @default(PENDING)
  attempts     Int            @default(0)
  maxAttempts  Int            @default(3)
  payload      Json
  html         String?        @db.Text
  error        String?
  messageId    String?
  scheduledFor DateTime       @default(now())
  sentAt       DateTime?
  failedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, scheduledFor])
  @@index([recipient])
  @@index([template])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// CHAPTERS & REGIONAL HUBS (, )
// ═══════════════════════════════════════════════════════════════════════════════

model Chapter {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  type            ChapterType         @default(CAMPUS)
  description     String?             @db.Text
  institution     String?             // e.g. "IIT Delhi", "MNIT Jaipur"
  cityId          String?
  state           String?
  leadId          String?
  status          ChapterStatus       @default(ACTIVE)
  bannerImage     String?
  logo            String?
  meetingCadence  String?             // e.g. "Bi-weekly Saturdays 5 PM"
  location        String?             // e.g. "Auditorium 3 / Lab 402"
  socialLinks     Json?               // { discord?: string, whatsapp?: string, github?: string, linkedin?: string }
  healthScore     Int                 @default(85) // 0-100 composite index
  healthStatus    ChapterHealthStatus @default(HEALTHY)
  foundedAt       DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  city            City?                  @relation(fields: [cityId], references: [id], onDelete: SetNull)
  lead            User?                  @relation("ChapterLeader", fields: [leadId], references: [id], onDelete: SetNull)
  members         ChapterMember[]
  events          ChapterEvent[]
  healthMetrics   ChapterHealthMetric[]
  bookingRequests SpeakerBookingRequest[]

  @@index([slug])
  @@index([type])
  @@index([status])
  @@index([cityId])
  @@index([leadId])
  isSeed        Boolean   @default(false)
}

model ChapterMember {
  id        String              @id @default(cuid())
  chapterId String
  userId    String
  role      ChapterMemberRole   @default(MEMBER)
  status    ChapterMemberStatus @default(ACTIVE)
  joinedAt  DateTime            @default(now())

  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chapterId, userId])
  @@index([chapterId])
  @@index([userId])
  @@index([role])
  isSeed        Boolean   @default(false)
}

model ChapterEvent {
  id              String             @id @default(cuid())
  chapterId       String
  eventId         String?
  title           String
  description     String?            @db.Text
  date            DateTime
  venue           String?
  attendanceCount Int                @default(0)
  rsvpsCount      Int                @default(0)
  status          ChapterEventStatus @default(UPCOMING)
  recapNotes      String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([chapterId])
  @@index([eventId])
  @@index([status])
  isSeed        Boolean   @default(false)
}

model ChapterHealthMetric {
  id               String   @id @default(cuid())
  chapterId        String
  recordedAt       DateTime @default(now())
  activeMembers    Int
  monthlyGrowth    Float    @default(0.0)
  eventsCount      Int      @default(0)
  avgAttendance    Float    @default(0.0)
  cadenceAdherence Int      @default(100) // %
  healthScore      Int      @default(85) // 0-100
  notes            String?

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@index([recordedAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// MENTOR / SPEAKER BOOKINGS (, )
// ═══════════════════════════════════════════════════════════════════════════════

model SpeakerBookingRequest {
  id              String               @id @default(cuid())
  speakerId       String
  requesterId     String
  chapterId       String?
  title           String
  topic           String
  sessionType     String               // "1:1 Mentorship", "Keynote Talk", "Hands-on Workshop", "Hackathon Judging"
  description     String               @db.Text
  preferredDate   DateTime
  durationMinutes Int                  @default(45)
  format          AttendanceMode       @default(VIRTUAL)
  meetingUrl      String?
  status          BookingRequestStatus @default(PENDING)
  declinedReason  String?
  mentorNotes     String?              @db.Text
  rating          Int?                 // 1-5
  feedback        String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  speaker   Speaker  @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  requester User     @relation("BookingRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([speakerId])
  @@index([requesterId])
  @@index([chapterId])
  @@index([status])
  isSeed        Boolean   @default(false)
}

// ═══════════════════════════════════════════════════════════════════════════════
// PARTNER EVENT REPORTS ()
// ═══════════════════════════════════════════════════════════════════════════════

model SponsorEventReport {
  id                 String   @id @default(cuid())
  dealId             String
  partnerId          String
  eventId            String
  title              String
  executiveSummary   String   @db.Text
  totalImpressions   Int      @default(0)
  totalAttendees     Int      @default(0)
  boothFootfall      Int?     @default(0)
  trackParticipants  Int?     @default(0)
  clickThroughRate   Float?   @default(0.0)
  leadCapturesCount  Int?     @default(0)
  mediaGalleryUrls   String[] @default([])
  recapDeckUrl       String?
  npsScore           Float?   @default(9.0)
  isPublished        Boolean  @default(true)
  publishedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  deal    SponsorDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  partner Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([partnerId])
  @@index([eventId])
  @@index([isPublished])
}

