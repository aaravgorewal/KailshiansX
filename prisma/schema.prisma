// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EVENT_MANAGER
  VIEWER
  CAMPUS_LEAD
  STATE_LEAD
  MEMBER
}

enum EventType {
  MEETUP
  HACKATHON
  WORKSHOP
  TECH_TALK
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum ApplicationStatus {
  NEW
  REVIEWING
  INTERVIEW
  SELECTED
  REJECTED
  ACTIVE
  ALUMNI
  INACTIVE
}

enum CollaborationType {
  COLLEGE
  COMMUNITY
  VENUE
  SPONSOR
}

// ─── Auth.js required tables ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(VIEWER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  registrations          Registration[]
  teamApplications       TeamApplication[]
  campusLeadApplications CampusLeadApplication[]
  stateLeadApplications  StateLeadApplication[]
}

// ─── Events ───────────────────────────────────────────────────────────────────

model Event {
  id                   String      @id @default(cuid())
  slug                 String      @unique
  title                String
  type                 EventType
  status               EventStatus @default(DRAFT)
  description          String?     @db.Text
  coverImage           String?
  city                 String?
  venue                String?
  venueAddress         String?
  startDate            DateTime
  endDate              DateTime?
  registrationDeadline DateTime?
  isFree               Boolean     @default(true)
  ticketPrice          Decimal?    @db.Decimal(10, 2)
  maxCapacity          Int?
  eligibility          String?     @db.Text
  schedule             Json? // Array of { time, title, speaker }
  faqs                 Json? // Array of { question, answer }
  meetupSeriesId       String?
  hackathonSeriesId    String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  registrations   Registration[]
  speakers        EventSpeaker[]
  partners        EventPartner[]
  galleryMedia    GalleryMedia[]
  meetupSeries    MeetupSeries?    @relation(fields: [meetupSeriesId], references: [id])
  hackathonSeries HackathonSeries? @relation(fields: [hackathonSeriesId], references: [id])
  eventPnL        EventPnL?
}

model EventSpeaker {
  id      String  @id @default(cuid())
  eventId String
  name    String
  role    String?
  bio     String? @db.Text
  photo   String?
  linkedin String?
  twitter String?
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventPartner {
  id      String  @id @default(cuid())
  eventId String
  name    String
  logo    String?
  website String?
  tier    String?
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ─── Meetup Series ────────────────────────────────────────────────────────────

model MeetupSeries {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  city        String?
  description String?  @db.Text
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events Event[]
}

// ─── Hackathon Series ─────────────────────────────────────────────────────────

model HackathonSeries {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events Event[]
}

// ─── Registration & Payments ──────────────────────────────────────────────────

model Registration {
  id             String             @id @default(cuid())
  registrationId String             @unique @default(cuid())
  eventId        String
  userId         String?
  name           String
  email          String
  phone          String?
  ticketType     String?
  status         RegistrationStatus @default(PENDING)
  paymentStatus  PaymentStatus      @default(UNPAID)
  paymentId      String?
  amount         Decimal?           @db.Decimal(10, 2)
  attended       Boolean            @default(false)
  qrCode         String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  event Event @relation(fields: [eventId], references: [id])
  user  User? @relation(fields: [userId], references: [id])
}

// ─── Event P&L ───────────────────────────────────────────────────────────────

model EventPnL {
  id             String  @id @default(cuid())
  eventId        String  @unique
  ticketRevenue  Decimal @default(0) @db.Decimal(10, 2)
  sponsorRevenue Decimal @default(0) @db.Decimal(10, 2)
  otherRevenue   Decimal @default(0) @db.Decimal(10, 2)
  venueCost      Decimal @default(0) @db.Decimal(10, 2)
  travelCost     Decimal @default(0) @db.Decimal(10, 2)
  foodCost       Decimal @default(0) @db.Decimal(10, 2)
  swagCost       Decimal @default(0) @db.Decimal(10, 2)
  marketingCost  Decimal @default(0) @db.Decimal(10, 2)
  printingCost   Decimal @default(0) @db.Decimal(10, 2)
  operationsCost Decimal @default(0) @db.Decimal(10, 2)
  otherCost      Decimal @default(0) @db.Decimal(10, 2)
  notes          String? @db.Text

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ─── Gallery ──────────────────────────────────────────────────────────────────

model GalleryMedia {
  id        String   @id @default(cuid())
  eventId   String?
  category  String // meetup, hackathon, workshop, tech-talk, community, bts
  url       String
  caption   String?
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event Event? @relation(fields: [eventId], references: [id])
}

// ─── Team Applications ────────────────────────────────────────────────────────

model TeamApplication {
  id         String            @id @default(cuid())
  userId     String?
  name       String
  email      String
  phone      String?
  department String
  role       String?
  linkedin   String?
  portfolio  String?
  experience String?           @db.Text
  motivation String?           @db.Text
  status     ApplicationStatus @default(NEW)
  adminNotes String?           @db.Text
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

// ─── Campus Lead Applications ─────────────────────────────────────────────────

model CampusLeadApplication {
  id                   String            @id @default(cuid())
  userId               String?
  name                 String
  email                String
  phone                String?
  college              String
  city                 String
  courseYear           String?
  linkedin             String?
  experience           String?           @db.Text
  communityInvolvement String?           @db.Text
  whyKailshiansX       String?           @db.Text
  availability         String?
  status               ApplicationStatus @default(NEW)
  adminNotes           String?           @db.Text
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

// ─── State Lead Applications ──────────────────────────────────────────────────

model StateLeadApplication {
  id                 String            @id @default(cuid())
  userId             String?
  name               String
  email              String
  phone              String?
  state              String
  cities             String?
  linkedin           String?
  experience         String?           @db.Text
  leadershipEvidence String?           @db.Text
  whyKailshiansX     String?           @db.Text
  status             ApplicationStatus @default(NEW)
  adminNotes         String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

// ─── Collaborations ───────────────────────────────────────────────────────────

model Collaboration {
  id               String            @id @default(cuid())
  type             CollaborationType
  organisation     String
  contactPerson    String
  email            String
  phone            String?
  website          String?
  city             String?
  proposedEvent    String?           @db.Text
  resourcesOffered String?           @db.Text
  message          String?           @db.Text
  status           ApplicationStatus @default(NEW)
  adminNotes       String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// ─── Core Team ────────────────────────────────────────────────────────────────

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  category  String // leadership, technology, community, events, partnerships, marketing, operations
  bio       String?  @db.Text
  photo     String?
  linkedin  String?
  twitter   String?
  github    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
