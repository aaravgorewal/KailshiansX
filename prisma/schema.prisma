enum LeadActivityType {
  WORKSHOP_HOSTING
  INFO_SESSION
  MEETUP_ORGANIZING
  HACKATHON_BOOTH
  COLLEGE_OUTREACH
  POSTER_DISTRIBUTION
  SPEAKER_INVITATION
  SOCIAL_CAMPAIGN
  PARTNERSHIP_MEETING
  OTHER
}

enum MonthlyReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  FLAGGED
}

model LeadActivity {
  id              String           @id @default(cuid())
  title           String
  type            LeadActivityType @default(COLLEGE_OUTREACH)
  description     String           @db.Text
  date            DateTime         @default(now())
  hoursSpent      Float            @default(1.0)
  attendeesCount  Int              @default(0)
  proofUrls       String[]         @default([])
  verifiedByAdmin Boolean          @default(false)
  adminFeedback   String?          @db.Text

  campusLeadId    String?
  stateLeadId     String?
  eventId         String?

  campusLead      CampusLead?      @relation(fields: [campusLeadId], references: [id], onDelete: Cascade)
  stateLead       StateLead?       @relation(fields: [stateLeadId], references: [id], onDelete: Cascade)
  event           Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([campusLeadId])
  @@index([stateLeadId])
  @@index([type])
  @@index([date])
  isSeed        Boolean   @default(false)
}

model LeadMonthlyReport {
  id                   String              @id @default(cuid())
  month                Int                 // 1-12
  year                 Int                 // e.g. 2026
  status               MonthlyReportStatus @default(SUBMITTED)
  summary              String              @db.Text
  highlights           String?             @db.Text
  challenges           String?             @db.Text
  nextMonthPlans       String?             @db.Text
  newSignupsCount      Int                 @default(0)
  eventsOrganizedCount Int                 @default(0)
  swagDistributedCount Int                 @default(0)
  performanceScore     Int?                // evaluation score out of 100
  adminFeedback        String?             @db.Text
  submittedAt          DateTime            @default(now())
  reviewedAt           DateTime?

  campusLeadId         String?
  stateLeadId          String?

  campusLead           CampusLead?         @relation(fields: [campusLeadId], references: [id], onDelete: Cascade)
  stateLead            StateLead?          @relation(fields: [stateLeadId], references: [id], onDelete: Cascade)

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([campusLeadId, month, year])
  @@unique([stateLeadId, month, year])
  @@index([month, year])
  @@index([status])
  isSeed        Boolean   @default(false)
}

model CampusLeadEvent {
  id           String     @id @default(cuid())
  campusLeadId String
  eventId      String
  role         String     @default("ORGANIZER")
  notes        String?

  campusLead   CampusLead @relation(fields: [campusLeadId], references: [id], onDelete: Cascade)
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@unique([campusLeadId, eventId])
  @@index([campusLeadId])
  @@index([eventId])
  isSeed        Boolean   @default(false)
}

model StateLeadEvent {
  id          String    @id @default(cuid())
  stateLeadId String
  eventId     String
  role        String    @default("REGIONAL_COORDINATOR")
  notes       String?

  stateLead   StateLead @relation(fields: [stateLeadId], references: [id], onDelete: Cascade)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@unique([stateLeadId, eventId])
  @@index([stateLeadId])
  @@index([eventId])
  isSeed        Boolean   @default(false)
}

