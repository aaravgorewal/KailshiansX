  status      DeliverableStatus @default(PENDING)
  dueDate     DateTime?
  fulfilledAt DateTime?
  proofUrl    String?
  assignee    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

