// ═══════════════════════════════════════════════════════════════════════════════
// CERTIFICATES
// ═══════════════════════════════════════════════════════════════════════════════

model CertificateTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  templateUrl String   // S3 URL of the base template image
  fields      Json     // Array of { key, x, y, fontSize, color, fontFamily }
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  certificates Certificate[]
  isSeed        Boolean   @default(false)
}

model Certificate {
  id               String         @id @default(cuid())
  uniqueId         String         @unique @default(cuid()) // public verification ID e.g. KX-CERT-abc123
  eventId          String
  registrationId   String?        @unique
  templateId       String
  participantName  String
  participantEmail String
  userId           String?
  issuedAt         DateTime       @default(now())
  certificateUrl   String?        // generated S3 URL or PDF storage URL
  emailSentAt      DateTime?
  deliveryStatus   EmailJobStatus @default(PENDING)
  deliveryError    String?

  event        Event               @relation(fields: [eventId], references: [id])
  registration Registration?       @relation(fields: [registrationId], references: [id])
  template     CertificateTemplate @relation(fields: [templateId], references: [id])
  user         User?               @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([participantEmail])
  @@index([userId])
  @@index([uniqueId])
  @@index([deliveryStatus])
  isSeed        Boolean   @default(false)
}

